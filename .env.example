# Copiar a .env y completar con valores reales (el .env está ignorado por Git).
# Nunca subir claves privadas al repositorio.

MYSQL_ROOT_PASSWORD=ticketya
RABBITMQ_USER=ticketya
RABBITMQ_PASSWORD=ticketya
AUTH_ADMIN_PASSWORD=Admin123!

# Claves RSA estables del auth-service (RS256).
# Generar UNA vez con:
#   openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 -out auth_private.pem
#   openssl pkey -in auth_private.pem -outform DER | base64 -w0 > auth_private.b64
#   openssl rsa -in auth_private.pem -pubout -outform DER | base64 -w0 > auth_public.b64
# Luego pegar el contenido de cada .b64 en la variable correspondiente (sin saltos de línea).
AUTH_JWT_PRIVATE_KEY=PEGAR_CONTENIDO_DE_auth_private.b64
AUTH_JWT_PUBLIC_KEY=PEGAR_CONTENIDO_DE_auth_public.b64
